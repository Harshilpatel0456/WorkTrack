# Copy to .env.production, replace every placeholder, and keep the file private.
DEBUG=False
SECRET_KEY=replace-with-a-unique-random-secret-at-least-50-characters-long
ALLOWED_HOSTS=worktrack.example.com,localhost
FRONTEND_URL=https://worktrack.example.com
CORS_ALLOWED_ORIGINS=https://worktrack.example.com
CSRF_TRUSTED_ORIGINS=https://worktrack.example.com

DB_NAME=worktrack
DB_USER=worktrack
DB_PASSWORD=change-me-to-a-long-random-database-password
REDIS_PASSWORD=change-me-to-a-long-alphanumeric-redis-password

VITE_API_BASE_URL=/api/v1
FRONTEND_PORT=8080

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
LOGIN_RATE_LIMIT=5/minute
REGISTRATION_RATE_LIMIT=5/hour
PASSWORD_RESET_RATE_LIMIT=3/hour
PASSWORD_RESET_CONFIRM_RATE_LIMIT=10/hour

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=notifications@worktrack.example.com
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
