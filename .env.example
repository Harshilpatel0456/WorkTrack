# Local development only. Copy to .env and replace the sample password values.
SECRET_KEY=replace-with-a-random-development-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

DB_ENGINE=postgresql
DB_NAME=worktrack_db
DB_USER=worktrack_user
DB_PASSWORD=change-me-local-db-password
DB_HOST=127.0.0.1
DB_PORT=5432

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
VITE_ENABLE_DEMO_MODE=false

JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
LOGIN_RATE_LIMIT=5/minute
REGISTRATION_RATE_LIMIT=5/hour
PASSWORD_RESET_RATE_LIMIT=3/hour
PASSWORD_RESET_CONFIRM_RATE_LIMIT=10/hour

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
REDIS_URL=redis://127.0.0.1:6379/0

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=notifications@worktrack.demo
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
