# ==============================================================================
# WorkTrack Enterprise: Docker & Environment Variables Configuration Template
# Copy this file to '.env' in the project root to configure local/Docker setups.
# ==============================================================================

# Core Django Security
SECRET_KEY=django-insecure-worktrack-enterprise-super-secret-key-2026-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend

# Database Configuration (PostgreSQL 16)
DB_ENGINE=postgresql
DB_NAME=worktrack_db
DB_USER=worktrack_user
DB_PASSWORD=worktrack_secure_pass_2026
DB_HOST=db
DB_PORT=5432

# (Optional: set DB_HOST=localhost if running Django locally outside Docker while PostgreSQL runs in Docker)
# DB_HOST=localhost

# Frontend & CORS Configuration
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_ENABLE_DEMO_MODE=false

# JWT Token Lifespans
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Celery & Redis Configuration
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# Email Backend (Console for local development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
